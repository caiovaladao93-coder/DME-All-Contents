 "captions": [
  {
   "start": 0.6,
   "end": 4.387,
   "text": "Na advocacia previdenciária, cada caso tem seu caminho."
  },
  {
   "start": 6.4,
   "end": 9.221,
   "text": "São pessoas, documentos, etapas"
  },
  {
   "start": 9.221,
   "end": 12.23,
   "text": "e responsabilidades que precisam ser acompanhados."
  },
  {
   "start": 12.4,
   "end": 15.233,
   "text": "A ADV Station é uma família de softwares de gestão"
  },
  {
   "start": 15.233,
   "end": 17.394,
   "text": "desenvolvida para essa rotina."
  },
  {
   "start": 18.0,
   "end": 22.331,
   "text": "Nossa proposta é ajudar o escritório a organizar informações,"
  },
  {
   "start": 22.331,
   "end": 23.851,
   "text": "acompanhar os casos"
  },
  {
   "start": 23.851,
   "end": 26.291,
   "text": "e coordenar o trabalho da equipe."
  },
  {
   "start": 26.324,
   "end": 28.66,
   "text": "Com soluções especializadas."
  },
  {
   "start": 29.6,
   "end": 32.073,
   "text": "O Maternidade Legal é voltado"
  },
  {
   "start": 32.073,
   "end": 35.291,
   "text": "à gestão de casos de salário-maternidade."
  },
  {
   "start": 36.6,
   "end": 40.629,
   "text": "O Previdenciário Geral atende a gestão de aposentadorias,"
  },
  {
   "start": 40.629,
   "end": 45.634,
   "text": "benefícios por incapacidade, pensão por morte e auxílio-acidente."
  },
  {
   "start": 46.2,
   "end": 48.661,
   "text": "Duas soluções para diferentes rotinas,"
  },
  {
   "start": 48.661,
   "end": 50.73,
   "text": "com uma mesma visão de gestão."
  },
  {
   "start": 50.821,
   "end": 52.32,
   "text": "Mais organização."
  },
  {
   "start": 52.411,
   "end": 55.327,
   "text": "Mais clareza para acompanhar a operação."
  },
  {
   "start": 56.0,
   "end": 58.544,
   "text": "A experiência jurídica continua no centro."
  },
  {
   "start": 58.891,
   "end": 61.737,
   "text": "A tecnologia apoia o trabalho."
  },
  {
   "start": 62.2,
   "end": 65.151,
   "text": "ADV Station. Conheça nossas soluções."
  }
 ]

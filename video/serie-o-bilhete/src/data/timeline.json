 "scenes": [
  {
   "key": "gancho",
   "fala": "n1",
   "t0": 0.0,
   "t1": 5.151,
   "v0": 0.12,
   "v1": 4.801,
   "texto": "Você acertou os seis números da loteria… e a sua mãe doou o bilhete."
  },
  {
   "key": "ficha",
   "fala": "n2",
   "t0": 5.151,
   "t1": 12.942,
   "v0": 5.301,
   "v1": 12.442,
   "texto": "Você. 27 anos. Saldo na conta: R$ 312."
  },
  {
   "key": "flash",
   "fala": "n3",
   "t0": 12.942,
   "t1": 18.354,
   "v0": 13.092,
   "v1": 18.004,
   "texto": "O bilhete tava no bolso da calça jeans. Aquela rasgada no joelho."
  },
  {
   "key": "mae",
   "fala": "m1",
   "t0": 18.354,
   "t1": 23.187,
   "v0": 18.554,
   "v1": 22.687,
   "texto": "Doei pro bazar da igreja, filho. Tava velha."
  },
  {
   "key": "corrida",
   "fala": "n4",
   "t0": 23.187,
   "t1": 28.772,
   "v0": 23.337,
   "v1": 28.272,
   "texto": "O bazar fecha às 18h. Você nunca correu tanto na vida."
  },
  {
   "key": "bazar",
   "fala": "c1",
   "t0": 28.772,
   "t1": 34.206,
   "v0": 28.972,
   "v1": 33.906,
   "texto": "Calça jeans? Chegou umas 30 hoje, meu bem."
  },
  {
   "key": "busca",
   "fala": "n5",
   "t0": 34.206,
   "t1": 38.298,
   "v0": 34.356,
   "v1": 37.898,
   "texto": "Uma por uma. Nenhuma rasgada no joelho."
  },
  {
   "key": "vendi",
   "fala": "c2",
   "t0": 38.298,
   "t1": 44.512,
   "v0": 38.498,
   "v1": 44.212,
   "texto": "Ah… a rasgada? Vendi agorinha. Cinco reais."
  },
  {
   "key": "cinco",
   "fala": "n6",
   "t0": 44.512,
   "t1": 49.419,
   "v0": 44.662,
   "v1": 48.819,
   "texto": "Cinco reais. Pela calça de 48 milhões."
  },
  {
   "key": "capacete",
   "fala": "n7",
   "t0": 49.419,
   "t1": 54.239,
   "v0": 49.569,
   "v1": 53.739,
   "texto": "Quem comprou? Um rapaz de moto. Esqueceu o capacete."
  },
  {
   "key": "festa",
   "fala": "n8",
   "t0": 54.239,
   "t1": 61.389,
   "v0": 54.439,
   "v1": 60.989,
   "texto": "19h40. Festa lotada. E lá está ela. A calça. Dançando."
  },
  {
   "key": "leo",
   "fala": "l1",
   "t0": 61.389,
   "t1": 65.411,
   "v0": 61.589,
   "v1": 64.911,
   "texto": "Que foi? Tá olhando minha calça por quê?"
  },
  {
   "key": "audio",
   "fala": "m2",
   "t0": 65.411,
   "t1": 73.603,
   "v0": 65.911,
   "v1": 73.203,
   "texto": "Filho, antes de doar eu tirei um papelzinho do bolso. Joguei no lixo da cozinha."
  },
  {
   "key": "caminhao",
   "fala": "n9",
   "t0": 73.603,
   "t1": 80.442,
   "v0": 73.753,
   "v1": 79.942,
   "texto": "O caminhão do lixo passa às 20h. 8 minutos. Dois lugares. Um bilhete."
  },
  {
   "key": "escolha",
   "fala": "n10",
   "t0": 80.442,
   "t1": 84.261,
   "v0": 80.642,
   "v1": 83.761,
   "texto": "Você confia na sua mãe… ou na calça?"
  },
  {
   "key": "contagem",
   "fala": "n11",

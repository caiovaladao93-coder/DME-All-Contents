   "t1": 5.6,
   "v0": 2.5,
   "v1": 5.295,
   "texto": "Você aprova. Você cobra. Você lembra todo mundo."
  },
  {
   "key": "gargalo",
   "fala": "f03",
   "t0": 5.6,
   "t1": 8.513,
   "v0": 5.7,
   "v1": 7.893,
   "texto": "Isso não é dedicação. É gargalo."
  },
  {
   "key": "agora",
   "fala": "f04",
   "t0": 8.513,
   "t1": 10.91,
   "v0": 8.633,
   "v1": 10.61,
   "texto": "Agora, quem segura é o processo."
  },

   "t0": 13.438,
   "t1": 17.364,
   "v0": 13.538,
   "v1": 17.064,
   "texto": "A DME faz o diagnóstico, mapeia, padroniza e automatiza."
  },
  {
   "key": "auto",
   "fala": "f07",
   "t0": 17.364,
   "t1": 19.765,
   "v0": 17.464,
   "v1": 19.485,

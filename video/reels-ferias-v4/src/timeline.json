   "t0": 19.765,
   "t1": 21.765,
   "v0": 19.865,
   "v1": 21.241,
   "texto": "Segunda. Quarta. Sexta."
  },
  {
   "key": "verbos",
   "fala": "f09",
   "t0": 21.765,
   "t1": 25.77,
   "v0": 21.865,
   "v1": 25.52,
   "texto": "Mapeando. Padronizando. Automatizando. Acompanhando."
  },
  {

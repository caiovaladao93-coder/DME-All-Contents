 "captions": [
  {
   "start": 4.25,
   "end": 8.037,
   "text": "Na advocacia previdenciária, cada caso tem seu caminho."
  },
  {
   "start": 8.15,
   "end": 11.285,
   "text": "A ADV Station é uma família de softwares de gestão"
  },
  {
   "start": 11.285,
   "end": 14.351,
   "text": "desenvolvida para acompanhar essa rotina."
  },
  {
   "start": 14.6,
   "end": 17.92,
   "text": "No Maternidade Legal, a organização dos clientes"
  },
  {
   "start": 17.92,
   "end": 19.999,
   "text": "e o acompanhamento das etapas"
  },
  {
   "start": 19.999,
   "end": 23.031,
   "text": "apoiam o trabalho com salário-maternidade."
  },
  {
   "start": 23.3,
   "end": 26.75,
   "text": "Da preparação do protocolo ao acompanhamento do desfecho,"
  },
  {
   "start": 26.841,
   "end": 30.152,
   "text": "mais clareza sobre onde cada caso está."
  },
  {
   "start": 30.6,
   "end": 34.385,
   "text": "No Previdenciário Geral, a gestão reúne diferentes demandas,"
  },
  {
   "start": 34.385,
   "end": 37.916,
   "text": "com visão das rotinas administrativas e judiciais."
  },
  {
   "start": 38.1,
   "end": 40.852,
   "text": "Aposentadorias, benefícios por incapacidade,"
  },
  {
   "start": 40.852,
   "end": 43.466,
   "text": "pensão por morte e auxílio-acidente."
  },
  {
   "start": 43.9,
   "end": 49.126,
   "text": "Informações operacionais e financeiras ajudam a enxergar o conjunto."
  },
  {
   "start": 49.5,
   "end": 51.172,
   "text": "Duas soluções especializadas"
  },
  {
   "start": 51.172,
   "end": 56.352,
   "text": "para organizar informações, acompanhar casos e coordenar a operação."
  },
  {
   "start": 56.7,
   "end": 59.244,
   "text": "A experiência jurídica continua no centro."
  },
  {
   "start": 59.591,
   "end": 62.437,
   "text": "A tecnologia apoia o trabalho."
  },
  {
   "start": 63.75,
   "end": 66.701,
   "text": "ADV Station. Conheça nossas soluções."
  }
 ]

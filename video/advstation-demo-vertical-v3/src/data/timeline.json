 "captions": [
  {
   "start": 2.35,
   "end": 4.082,
   "text": "Cada caso tem seu caminho."
  },
  {
   "start": 4.242,
   "end": 6.45,
   "text": "Sua gestão precisa acompanhar."
  },
  {
   "start": 6.45,
   "end": 9.817,
   "text": "A ADV Station é uma família de softwares de gestão"
  },
  {
   "start": 9.817,
   "end": 13.116,
   "text": "especializada na advocacia previdenciária."
  },
  {
   "start": 13.2,
   "end": 17.101,
   "text": "No Maternidade Legal, clientes e informações organizados"
  },
  {
   "start": 17.101,
   "end": 20.33,
   "text": "apoiam a rotina de salário-maternidade."
  },
  {
   "start": 20.45,
   "end": 25.175,
   "text": "E o acompanhamento das etapas ajuda a entender onde cada caso está"
  },
  {
   "start": 25.175,
   "end": 27.209,
   "text": "e o que exige atenção."
  },
  {
   "start": 28.2,
   "end": 30.905,
   "text": "No Previdenciário Geral, diferentes demandas"
  },
  {
   "start": 30.905,
   "end": 34.169,
   "text": "compartilham uma necessidade: gestão."
  },
  {
   "start": 34.6,
   "end": 37.352,
   "text": "Aposentadorias, benefícios por incapacidade,"
  },
  {
   "start": 37.352,
   "end": 39.966,
   "text": "pensão por morte e auxílio-acidente."
  },
  {
   "start": 40.8,
   "end": 43.193,
   "text": "Aproxime o olhar de cada demanda."
  },
  {
   "start": 43.354,
   "end": 46.3,
   "text": "Amplie a visão da operação."
  },
  {
   "start": 46.3,
   "end": 48.879,
   "text": "Informações operacionais e financeiras"
  },
  {
   "start": 48.912,
   "end": 52.55,
   "text": "ajudam a acompanhar o conjunto do escritório."
  },
  {
   "start": 52.55,
   "end": 54.315,
   "text": "Duas soluções especializadas"
  },
  {
   "start": 54.315,
   "end": 58.3,
   "text": "para organizar, acompanhar e coordenar."
  },
  {
   "start": 58.3,
   "end": 60.844,
   "text": "A experiência jurídica continua no centro."
  },
  {
   "start": 61.191,
   "end": 64.037,
   "text": "A tecnologia apoia o trabalho."
  },
  {
   "start": 65.6,
   "end": 69.015,
   "text": "ADV Station. Conheça nossas soluções."
  }
 ]

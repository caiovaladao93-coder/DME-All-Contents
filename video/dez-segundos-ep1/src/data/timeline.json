 "scenes": [
  {
   "key": "notif",
   "fala": "n1",
   "t0": 0.0,
   "t1": 4.752,
   "v0": 0.05,
   "v1": 4.602,
   "texto": "Às 3h12 da manhã, meu vizinho me mandou um áudio."
  },
  {
   "key": "morto",
   "fala": "n2",
   "t0": 4.752,
   "t1": 7.813,
   "v0": 4.852,
   "v1": 7.313,
   "texto": "Às 7h, ele tava morto."
  },
  {
   "key": "fichas",
   "fala": "n3",
   "t0": 7.813,
   "t1": 14.007,
   "v0": 7.963,
   "v1": 13.607,
   "texto": "Eu moro no 301 faz dois meses. Ele era o único que falava comigo."
  },
  {
   "key": "policia",
   "fala": "n4",
   "t0": 14.007,
   "t1": 19.155,
   "v0": 14.157,
   "v1": 18.755,
   "texto": "A polícia disse que foi uma queda. Que ele escorregou no banheiro."
  },
  {
   "key": "play",
   "fala": "n5",
   "t0": 19.155,
   "t1": 23.242,
   "v0": 19.305,
   "v1": 22.742,
   "texto": "Só que eu ainda não tinha ouvido o áudio."
  },
  {
   "key": "audio",
   "fala": "e1",
   "t0": 23.242,
   "t1": 31.945,
   "v0": 23.642,
   "v1": 31.045,
   "texto": "Se acontecer alguma coisa comigo… não foi acidente. Foi o…"
  },
  {
   "key": "denovo",
   "fala": "n6",
   "t0": 31.945,
   "t1": 37.318,
   "v0": 32.095,
   "v1": 37.018,
   "texto": "O áudio acaba aí. Eu ouvi de novo. Com o volume no máximo."
  },
  {
   "key": "fundo",
   "fala": "n7",
   "t0": 37.318,
   "t1": 44.17,
   "v0": 37.468,
   "v1": 43.57,
   "texto": "No fundo… tem um barulho. Chaves. E alguém assobiando."
  },
  {
   "key": "batida",
   "fala": "n8",
   "t0": 44.17,
   "t1": 48.431,
   "v0": 45.67,
   "v1": 48.131,
   "texto": "Eu olhei pelo olho mágico."
  },
  {
   "key": "delegada",
   "fala": "d1",
   "t0": 48.431,
   "t1": 52.781,
   "v0": 48.631,
   "v1": 52.381,
   "texto": "Bom dia. Você ouviu alguma coisa essa noite?"
  },
  {
   "key": "assobio",
   "fala": "n9",
   "t0": 52.781,
   "t1": 59.052,
   "v0": 52.931,
   "v1": 58.552,
   "texto": "Eu ia contar. Até que, atrás dela… alguém começou a assobiar."
  },
  {
   "key": "valdir",
   "fala": "n10",
   "t0": 59.052,
   "t1": 65.129,
   "v0": 59.202,
   "v1": 64.729,
   "texto": "Seu Valdir. O porteiro. Ele tem a chave de todos os apartamentos."
  },
  {
   "key": "chave",
   "fala": "n11",
   "t0": 65.129,
   "t1": 68.8,
   "v0": 65.329,
   "v1": 68.2,
   "texto": "Inclusive… a do meu."
  },
  {
   "key": "entao",
   "fala": "d2",
   "t0": 68.8,
   "t1": 72.365,
   "v0": 69.0,
   "v1": 72.065,
   "texto": "Então? Ouviu ou não ouviu?"
  },
  {
   "key": "mensagem",
   "fala": "n12",
   "t0": 72.365,
   "t1": 76.587,
   "v0": 73.765,
   "v1": 76.087,
   "texto": "Alguém sabe que eu tenho esse áudio."
  },
  {
   "key": "escolha",
   "fala": "n13",
   "t0": 76.587,
   "t1": 83.042,
   "v0": 76.787,
   "v1": 82.542,
   "texto": "Eu mostro o áudio pra delegada… na frente dele? Ou apago e finjo que não ouvi nada?"
  },
  {
   "key": "contagem",
   "fala": "n14",
   "t0": 83.042,
   "t1": 94.042,
   "v0": 84.042,
   "v1": 88.013,
   "texto": "Comenta A ou B. Eu faço o que vocês mandarem."
  }
 ],

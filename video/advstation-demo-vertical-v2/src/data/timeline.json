 "captions": [
  {
   "start": 2.95,
   "end": 6.737,
   "text": "Na advocacia previdenciária, cada caso tem seu caminho."
  },
  {
   "start": 6.75,
   "end": 9.931,
   "text": "A ADV Station é uma família de softwares de gestão"
  },
  {
   "start": 9.931,
   "end": 12.069,
   "text": "especializada nessa rotina."
  },
  {
   "start": 12.3,
   "end": 16.723,
   "text": "No Maternidade Legal, clientes e informações ficam organizados"
  },
  {
   "start": 16.723,
   "end": 20.2,
   "text": "para apoiar o trabalho com salário-maternidade."
  },
  {
   "start": 20.2,
   "end": 24.879,
   "text": "O acompanhamento das etapas ajuda a visualizar onde cada caso está"
  },
  {
   "start": 24.879,
   "end": 26.959,
   "text": "e o que exige atenção."
  },
  {
   "start": 29.2,
   "end": 32.021,
   "text": "No Previdenciário Geral, a gestão acompanha"
  },
  {
   "start": 32.021,
   "end": 35.727,
   "text": "diferentes demandas administrativas e judiciais."
  },
  {
   "start": 35.85,
   "end": 38.602,
   "text": "Aposentadorias, benefícios por incapacidade,"
  },
  {
   "start": 38.602,
   "end": 41.216,
   "text": "pensão por morte e auxílio-acidente."
  },
  {
   "start": 41.6,
   "end": 46.548,
   "text": "A visão operacional e financeira ajuda a acompanhar o conjunto do escritório."
  },
  {
   "start": 47.45,
   "end": 49.565,
   "text": "Duas soluções especializadas."
  },
  {
   "start": 49.75,
   "end": 52.05,
   "text": "Mais organização das informações."
  },
  {
   "start": 52.084,
   "end": 56.509,
   "text": "Mais clareza para acompanhar os casos e coordenar a operação."
  },
  {
   "start": 57.0,
   "end": 59.544,
   "text": "A experiência jurídica continua no centro."
  },
  {
   "start": 59.891,
   "end": 62.737,
   "text": "A tecnologia apoia o trabalho."
  },
  {
   "start": 63.85,
   "end": 66.801,
   "text": "ADV Station. Conheça nossas soluções."
  }
 ]
